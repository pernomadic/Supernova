<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fullscreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oneui_dark_bg">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_dark_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/closeBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_search" />
        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_search_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <TextView
                android:id="@+id/searchPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_search_hint"
                android:textColor="@color/text_dark_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Cards Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card 1: Calendar & Weather -->
                <LinearLayout
                    android:id="@+id/card1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_card_plate_dark"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/fsCard1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feed_calendar"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fsCard1Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No upcoming events today. Have a productive day!"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Card 2: Quick Apps & Tools -->
                <LinearLayout
                    android:id="@+id/card2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_card_plate_dark"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/fsCard2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feed_quick_apps"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fsCard2Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Launch your favorite apps with OneUI frosted surfaces and fast response."
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Card 3: Notes & Tasks -->
                <LinearLayout
                    android:id="@+id/card3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_plate_dark"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/fsCard3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feed_tasks"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fsCard3Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Aryonova Feed Standalone Widget — 100% blur frosted glass with theme tints."
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
